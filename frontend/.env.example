VITE_ENABLE_GALLERY=true
VITE_ENABLE_CLUBS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_PROGRAMS=true
VITE_ENABLE_SERVICES=false
VITE_ENABLE_RADIO=true
VITE_ENABLE_EXCLUSIVE_FORMS=true
VITE_ENABLE_PARTNERS=true
